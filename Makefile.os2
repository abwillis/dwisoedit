#
# Makefile for DWISOEdit on OS/2
#
# Prerequisites expected in the standard include/library paths:
#
#   Dynamic Windows:
#       dw.h
#       dw.lib
#
#   bkisofs:
#       bk.h
#       bk.a
#
# The executable must be linked as an OS/2 Presentation Manager
# application using dwisoedit.def.
#

CC      = gcc
RM      = rm -f

TARGET  = dwisoedit.exe
OBJECTS = dwisoedit.o
DEF     = dwisoedit.def

#
# bkisofs uses 64-bit off_t. ISO Editor must be compiled with the
# same setting because VolInfo contains off_t fields.
#
CPPFLAGS = -D_FILE_OFFSET_BITS=64 -D__OS2__

CFLAGS = -O2 -Wall -Wextra -std=gnu99

#
# Generate native OS/2 OMF output and a linker map.
#
LDFLAGS = -Zomf -Zmap

#
# Both libraries are in the normal OS/2 library path.
#
LDLIBS = -lbk -ldw -lpthread

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJECTS) $(DEF)
	$(CC) $(LDFLAGS) -o $@ $(OBJECTS) $(DEF) $(LDLIBS)

isoedit.o: dwisoedit.c
	$(CC) $(CPPFLAGS) $(CFLAGS) -c dwisoedit.c -o dwisoedit.o

clean:
	$(RM) $(OBJECTS)
	$(RM) $(TARGET)
	$(RM) dwisoedit.map
